      "~ㄹ게요 문형으로 자신의 의사를 표현할 수 있다.",
      "~고 싶어요 문형으로 희망을 표현할 수 있다."
    ],
    "vocab": [
      { "ko": "김치찌개", "romanization": "gimchijjigae", "en": "Kimchi stew" },
      { "ko": "비빔밥", "romanization": "bibimbap", "en": "Bibimbap" },
      { "ko": "불고기", "romanization": "bulgogi", "en": "Bulgogi" },
      { "ko": "메뉴", "romanization": "menyu", "en": "Menu" },
      { "ko": "주문하다", "romanization": "jumunhada", "en": "to order" },
      { "ko": "맛있다", "romanization": "masitda", "en": "to be delicious" },
      { "ko": "물", "romanization": "mul", "en": "water" }
    ],
    "grammar": [
      {
        "pattern": "N(으)로 할게요",
        "explanation": "여러 선택지 중 하나를 결정할 때 사용하는 표현입니다.",
        "examples": [
          { "ko": "저는 비빔밥으로 할게요.", "en": "I'll have the bibimbap." },
