  {
    "id": 5,
    "title": "길 묻기와 교통",
    "titleEn": "Asking Directions & Transportation",
    "level": "초급 2",
    "objectives": [
      "길을 묻고 안내할 수 있다.",
      "~(으)로 가세요 문형으로 방향을 안내할 수 있다.",
      "대중교통 관련 기본 표현을 사용할 수 있다."
    ],
    "vocab": [
      { "ko": "여기", "romanization": "yeogi", "en": "here" },
      { "ko": "저기", "romanization": "jeogi", "en": "there (far)" },
      { "ko": "오른쪽", "romanization": "oreunjjok", "en": "right side" },
      { "ko": "왼쪽", "romanization": "oenjjok", "en": "left side" },
      { "ko": "똑바로 가세요", "romanization": "ttokbaro gaseyo", "en": "Go straight" },
      { "ko": "지하철역", "romanization": "jihacheollyeok", "en": "Subway station" },
      { "ko": "버스 정류장", "romanization": "beoseu jeongnyujang", "en": "Bus stop" }
    ],
    "grammar": [
      {
        "pattern": "N(으)로 가세요",
        "explanation": "방향이나 경로를 안내할 때 사용하는 표현입니다.",
        "examples": [
          { "ko": "오른쪽으로 가세요.", "en": "Go to the right." },
          { "ko": "이 길로 가세요.", "en": "Go this way." }
        ]
      },
      {
        "pattern": "N까지 어떻게 가요?",
        "explanation": "목적지까지 가는 방법을 물을 때 사용하는 표현입니다.",
        "examples": [
          { "ko": "지하철역까지 어떻게 가요?", "en": "How do I get to the subway station?" },
          { "ko": "학교까지 어떻게 가요?", "en": "How do I get to the school?" }
        ]
      }
    ],
    "dialogue": [
      { "speaker": "A", "ko": "실례합니다. 지하철역까지 어떻게 가요?", "en": "Excuse me. How do I get to the subway station?" },
      { "speaker": "B", "ko": "이 길로 똑바로 가세요. 그리고 오른쪽으로 가세요.", "en": "Go straight this way. Then go right." },
      { "speaker": "A", "ko": "감사합니다.", "en": "Thank you." }
    ],
    "quiz": [
