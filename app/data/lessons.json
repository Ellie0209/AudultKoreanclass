      {
        "type": "mcq",
        "question": "'비싸다'의 반대말은?",
        "options": ["작다", "크다", "싸다", "많다"],
        "answer": "싸다"
      }
    ]
  },
  {
    "id": 4,
    "title": "음식 주문하기",
    "titleEn": "Ordering Food",
    "level": "초급 2",
    "objectives": [
