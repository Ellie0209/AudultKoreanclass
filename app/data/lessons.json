        "explanation": "먹고 싶은 음식에 대한 희망을 나타내는 표현입니다.",
        "examples": [
          { "ko": "김치찌개가 먹고 싶어요.", "en": "I want to eat kimchi stew." },
          { "ko": "비빔밥이 먹고 싶어요.", "en": "I want to eat bibimbap." }
        ]
      }
    ],
    "dialogue": [
      { "speaker": "A", "ko": "어서 오세요. 뭐 드시겠어요?", "en": "Welcome. What would you like?" },
      { "speaker": "B", "ko": "저는 비빔밥으로 할게요.", "en": "I'll have the bibimbap." },
      { "speaker": "A", "ko": "음료는요?", "en": "And a drink?" },
      { "speaker": "B", "ko": "물 주세요.", "en": "Water, please." }
